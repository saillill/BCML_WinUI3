<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BCML.WinUI3.App.Pages.SetupWizardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:controls="using:BCML.WinUI3.App.Controls">

    <Grid Padding="24,18,24,16" RowSpacing="14"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock
            x:Name="WizardTitle"
            Grid.Row="0"
            Text="欢迎使用 BCML"
            Style="{StaticResource TitleTextBlockStyle}" />

        <!-- 步骤条：4 个圆点 + 标签 -->
        <StackPanel
            x:Name="StepBar"
            Grid.Row="1"
            Orientation="Horizontal"
            Spacing="22">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="20" Height="20" CornerRadius="10" VerticalAlignment="Center"
                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <TextBlock Text="1" Foreground="White" FontSize="11"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="StepLabel1" Text="开始" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="20" Height="20" CornerRadius="10" VerticalAlignment="Center"
                        Background="{ThemeResource ControlStrongFillColorDisabledBrush}">
                    <TextBlock Text="2" Foreground="White" FontSize="11"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="StepLabel2" Text="旧版设置" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="20" Height="20" CornerRadius="10" VerticalAlignment="Center"
                        Background="{ThemeResource ControlStrongFillColorDisabledBrush}">
                    <TextBlock Text="3" Foreground="White" FontSize="11"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="StepLabel3" Text="基本设置" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="20" Height="20" CornerRadius="10" VerticalAlignment="Center"
                        Background="{ThemeResource ControlStrongFillColorDisabledBrush}">
                    <TextBlock Text="4" Foreground="White" FontSize="11"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="StepLabel4" Text="完成" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </StackPanel>

        <!-- 分页内容 -->
        <Grid Grid.Row="2">
            <!-- HorizontalScrollBarVisibility 必须显式关掉：
                 默认值会让 ScrollViewer 给内容「无限宽度」，导致内部
                 HorizontalAlignment="Center" 相对这个超宽画布居中，
                 内容反而被推到视口右侧外面去。 -->
            <ScrollViewer x:Name="WizardScroll"
                          HorizontalScrollMode="Disabled"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          SizeChanged="WizardScroll_SizeChanged">
                <!-- 内层 Grid 的宽度在 code-behind 里随视口同步（见 WizardScroll_SizeChanged）。
                     原因：ScrollViewer 默认给内容无限宽度，内层 Grid 会按「最宽的子页面」测量，
                     比视口还宽，子页面里的 Center 也就跟着偏右；XAML 里绑 ViewportWidth
                     在 WinUI 3 上不生效，只能手动同步。 -->
                <Grid x:Name="PageHost">
                    <!-- 第 1 页：欢迎 -->
                    <StackPanel x:Name="Page1" Spacing="12" MaxWidth="620" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE8B9;" FontSize="44"
                                  HorizontalAlignment="Center"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="Step1Title" Style="{StaticResource SubtitleTextBlockStyle}"
                                   Text="感谢安装 BCML" HorizontalAlignment="Center" />
                        <TextBlock x:Name="Step1Body" TextWrapping="Wrap" LineHeight="24"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   Text="看起来这是你第一次运行本应用，或从旧版本升级而来。需要做一些设置才能顺利开始。" />
                        <TextBlock x:Name="Step1Note" TextWrapping="Wrap" LineHeight="24"
                                   Margin="0,4,0,0"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   Style="{StaticResource CaptionSecondaryTextStyle}" />
                    </StackPanel>

                    <!-- 第 2 页：旧设置 / 旧模组 -->
                    <StackPanel x:Name="Page2" Spacing="12" MaxWidth="620" HorizontalAlignment="Center" Visibility="Collapsed">
                        <FontIcon Glyph="&#xE8B5;" FontSize="40"
                                  HorizontalAlignment="Center"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="Step2Title" Style="{StaticResource SubtitleTextBlockStyle}"
                                   Text="导入旧设置" HorizontalAlignment="Center" />
                        <TextBlock x:Name="Step2Body" TextWrapping="Wrap" LineHeight="24"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   Text="如果你之前装过 BCML，它已经自动尝试导入旧设置；没装过也没关系，下一页从头配置即可。" />
                        <Border CornerRadius="6" Padding="12"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="Step2SharedNote"
                                           Text="本应用与 BCML 共用同一份配置与模组目录 —— 已经装好的模组、配置档案与备份都直接可用，无需重复迁移。"
                                           TextWrapping="Wrap"
                                           Style="{StaticResource CaptionSecondaryTextStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 第 3 页：基本设置 -->
                    <StackPanel x:Name="Page3" Spacing="12" MaxWidth="720" HorizontalAlignment="Center" Visibility="Collapsed">
                        <TextBlock x:Name="Step3Title" Style="{StaticResource SubtitleTextBlockStyle}"
                                   Text="基本设置" HorizontalAlignment="Center" />
                        <TextBlock x:Name="Step3Body" TextWrapping="Wrap" LineHeight="22"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   Text="花一点时间配置游戏目录。路径校验通过后右侧的卡片会变成绿色对勾。" />

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ToggleSwitch x:Name="WiiuToggle" OffContent="" OnContent=""
                                          MinWidth="0"
                                          Toggled="WiiuToggle_Toggled" />
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Name="WiiuLabel" Text="Wii U 模式" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="WiiuHint" TextWrapping="Wrap"
                                           Style="{StaticResource CaptionSecondaryTextStyle}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="PathList" Spacing="10" />

                        <TextBlock x:Name="SaveHint" TextWrapping="Wrap"
                                   Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                    </StackPanel>

                    <!-- 第 4 页：完成 -->
                    <StackPanel x:Name="Page4" Spacing="12" MaxWidth="620" HorizontalAlignment="Center" Visibility="Collapsed">
                        <FontIcon Glyph="&#xE73E;" FontSize="44"
                                  HorizontalAlignment="Center"
                                  Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        <TextBlock x:Name="Step4Title" Style="{StaticResource SubtitleTextBlockStyle}"
                                   Text="设置完成" HorizontalAlignment="Center" />
                        <TextBlock x:Name="Step4Body" TextWrapping="Wrap" LineHeight="24"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   Text="一切就绪，开始安装模组吧！" />

                        <muxc:InfoBar x:Name="NewbieTip"
                                      IsOpen="True" IsClosable="False" Severity="Informational"
                                      HorizontalAlignment="Stretch"
                                      Title="新手提示">
                            <muxc:InfoBar.Content>
                                <StackPanel Spacing="8">
                                    <TextBlock x:Name="NewbieTipBody" TextWrapping="Wrap"
                                               Text="如果遇到问题，先尝试点「重新合并」；排序有疑问时，打开「排序模式」拖动调整。" />
                                    <CheckBox x:Name="ConsentCheck" Checked="ConsentCheck_Changed" Unchecked="ConsentCheck_Changed" />
                                </StackPanel>
                            </muxc:InfoBar.Content>
                        </muxc:InfoBar>

                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <Button x:Name="HelpButton" Click="Help_Click" />
                            <Button x:Name="DonateButton" Click="Donate_Click" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- 底部按钮：左侧「上一步」固定贴左，右侧「跳过向导」+ 主操作贴右。
             主操作（下一步 / 保存并继续 / 完成）三者放在同一个单元格里互斥叠加，
             这样无论当前是哪一个，它的右边缘都落在同一位置 —— 翻页时不会左右跳动。
             跳过的按钮 Collapsed 后不占位，但主操作的位置由叠加层锁定，不受影响。 -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="BackButton" Grid.Column="0" Click="Back_Click"
                    VerticalAlignment="Center" />

            <Button x:Name="SkipButton" Grid.Column="2" Click="Skip_Click"
                    VerticalAlignment="Center" Margin="0,0,8,0" />

            <!-- 三个主操作互斥叠加：同一单元格、右对齐 -->
            <Grid Grid.Column="3" VerticalAlignment="Center">
                <Button x:Name="NextButton" Click="Next_Click"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Right" />
                <Button x:Name="SaveButton" Click="Save_Click"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Right" />
                <Button x:Name="FinishButton" Click="Finish_Click"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Right" />
            </Grid>
        </Grid>
    </Grid>
</Page>
