<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="BCML.WinUI3.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="BCML-WinUI3">

    <Grid x:Name="RootGrid" SizeChanged="RootGrid_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            自绘顶栏（ExtendsContentIntoTitleBar = true，系统顶栏不显示）。
            [☰] 与「BCML-WinUI3」在同一排；右侧留给系统的最小化/最大化/关闭按钮。
            注意：只有 TitleBarDragRegion 被 SetTitleBar 设为拖拽区，
            ☰ 按钮在它左边的独立列里，所以仍然可点。
        -->
        <Grid
            Grid.Row="0"
            Height="44"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="PaneToggleButton"
                Grid.Column="0"
                Click="PaneToggle_Click"
                Margin="6,0,0,0"
                Padding="8,4"
                MinWidth="0"
                MinHeight="0"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0">
                <!-- ToolTip 与无障碍名都在 ApplyLanguage() 里随语言刷新（XAML 里写死会锁死中文）。 -->
                <FontIcon Glyph="&#xE700;" FontSize="14" />
            </Button>

            <Grid x:Name="TitleBarDragRegion" Grid.Column="1" Background="Transparent">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock
                        x:Name="AppTitleText"
                        Text="BCML-WinUI3"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>

        <muxc:NavigationView
            x:Name="Nav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            OpenPaneLength="190"
            SelectionChanged="Nav_SelectionChanged">
            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="模组" Tag="mods" Icon="AllApps" />
                <muxc:NavigationViewItem Content="设置" Tag="settings" Icon="Setting" />
                <muxc:NavigationViewItem Content="工具" Tag="tools" Icon="Repair" />
                <muxc:NavigationViewItem Content="日志" Tag="logs" Icon="Document" />
            </muxc:NavigationView.MenuItems>

            <!-- 两个 ContentAlignment 都必须显式 Stretch：
                 否则在窗口偏小时页面只拿到「期望高度」而不是填满，整体会飘到中间。 -->
            <Frame
                x:Name="ContentFrame"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch" />
        </muxc:NavigationView>

        <!-- 状态栏：后端状态 / BCML 版本 / 重试 -->
        <Border
            Grid.Row="2"
            BorderThickness="0,1,0,0"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            Padding="12,6">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ProgressRing
                    x:Name="StatusRing"
                    Grid.Column="0"
                    Width="16" Height="16"
                    IsActive="True"
                    Visibility="Collapsed" />

                <TextBlock
                    x:Name="StatusText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="正在准备…" />

                <Button
                    x:Name="RetryButton"
                    Grid.Column="2"
                    Visibility="Collapsed"
                    Click="RetryButton_Click"
                    Content="重试启动后端" />
            </Grid>
        </Border>

        <!-- 首次运行引导：整页遮罩，完成后不再出现。
             背景用不透明的 ApplicationPageBackgroundThemeBrush，否则会透出下面的模组列表。 -->
        <ContentControl
            x:Name="WizardHost"
            Grid.Row="0"
            Grid.RowSpan="3"
            Visibility="Collapsed"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch" />

        <!-- 忙碌遮罩：BCML 的合并要跑几分钟，必须挡住误操作 -->
        <Grid
            x:Name="BusyOverlay"
            Grid.RowSpan="3"
            Visibility="Collapsed"
            Background="{ThemeResource BusyScrimBrush}">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="14"
                MaxWidth="520">
                <ProgressRing IsActive="True" Width="52" Height="52" HorizontalAlignment="Center" />
                <TextBlock
                    x:Name="BusyText"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="处理中…" />
                <TextBlock
                    x:Name="BusyDetail"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <!-- 俏皮标语：每 5 秒换一条，与原版 Progress.jsx 的节奏一致 -->
                <TextBlock
                    x:Name="BusySlogan"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    FontStyle="Italic"
                    Margin="0,10,0,0"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
