<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="BCML.WinUI3.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 只引入官方控件资源：不自定义任何颜色/画刷，强调色与浅色/深色/高对比度
                     全部交给官方 ThemeDictionaries 自动切换。 -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 副标题/说明文字统一用这个，避免各处硬编码灰色。 -->
            <Style x:Key="CaptionSecondaryTextStyle" TargetType="TextBlock"
                   BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <!--
                详情区的**区块标题**（模组信息 / 内容描述 / 可用操作 / 前置依赖 …）。

                为什么不直接用 BodyStrongTextBlockStyle：那是 14px 半粗，和正文
                （RichTextBlock，LineHeight 20）**同号**，只靠一点点字重差区分，
                一屏文字堆下来标题完全"沉"进正文里，扫读时找不到段落边界。

                这里让它比正文明显高一档：
                  · 字号 16（正文 14）—— 拉开字号差，这是最有效的层次信号；
                  · 字重 SemiBold 保留；
                  · 下边距 2 —— 让标题与它统领的内容之间**比**与上一段之间更近，
                    视觉上形成"标题贴着自己的内容"的分组感（格式塔的接近性原则）。
                颜色不写死，跟随主题前景色。
            -->
            <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="Margin" Value="0,0,0,2" />
            </Style>

            <!--
                紧凑图标按钮（保留给仍需纯图标的地方）。
                WinUI 的 Button 默认 MinWidth=120、Padding=12,6 —— 图标按钮条排不进
                470px 的详情栏。这里压成 40×40 的方块，图标居中，文字交给 ToolTip。

                尺寸取 40×40 而不是更小的 36×34：40 是 Windows 无障碍（触控/指针）
                建议的最小命中区。
            -->
            <Style x:Key="IconActionButtonStyle" TargetType="Button"
                   BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <!--
                详情区「可用操作」条的按钮：图标 + 文字。
                纯图标按钮对不认识图标的人等于没有提示，所以每个按钮都带文字说明。
                高度固定 36 保证一行视觉整齐；宽度让内容自己撑开（MinWidth=0 抵消
                框架默认的 120），放不下时由外层 WrapPanel 折行。
            -->
            <Style x:Key="ActionTextButtonStyle" TargetType="Button"
                   BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Height" Value="36" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <!--
                危险操作按钮（卸载）：与 ActionTextButtonStyle 同尺寸，但要一眼看出
                是破坏性操作，所以在四个状态（常态 / 悬浮 / 按下 / 禁用）各套一层红色。

                只覆盖 Background / Foreground / BorderBrush，**不重写控件模板** ——
                模板里的圆角、焦点框、按压缩放动画全部沿用官方实现，浅色 / 深色 /
                高对比度主题的其它细节也不会跑偏。

                注意 Foreground 只在禁用态必须换：常态用主题红在浅色底上足够，
                但禁用态若照搬会被官方 DefaultButtonStyle 的 TextFillColorDisabledBrush
                覆盖成灰，灰字配红底反而更像"可点"。这里显式给它一个灰。
            -->
            <Style x:Key="DangerTextButtonStyle" TargetType="Button"
                   BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Height" Value="36" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="{ThemeResource SystemFillColorCriticalBackgroundBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>

            <!--
                忙碌遮罩的底色。不用框架的 Smoke* 资源：那是给 ContentDialog 的烟雾层准备的，
                名称与可用性在不同 WinUI 版本间不稳。这里按主题各给一个半透明色，
                保证浅色主题下遮罩后的文字仍然是深色、深色主题下是浅色。
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="BusyScrimBrush" Color="#99FFFFFF" />
                    <!-- 危险按钮的悬浮 / 按下底色：在浅色主题上把主题红往白里调一点，
                         这样红底上的深红文字仍有足够对比度（纯主题红当底会糊成一片）。 -->
                    <SolidColorBrush x:Key="DangerButtonHoverBrush" Color="#2EC42B1C" />
                    <SolidColorBrush x:Key="DangerButtonPressedBrush" Color="#4AC42B1C" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="BusyScrimBrush" Color="#B3000000" />
                    <!-- 深色主题反过来：红往黑里压，避免深色界面里突然一块亮红抢眼。 -->
                    <SolidColorBrush x:Key="DangerButtonHoverBrush" Color="#33FF99A4" />
                    <SolidColorBrush x:Key="DangerButtonPressedBrush" Color="#55FF99A4" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="BusyScrimBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <!-- 高对比度下红色可能被系统配色冲掉，直接交给系统高亮色，保证可见。 -->
                    <SolidColorBrush x:Key="DangerButtonHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="DangerButtonPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
